SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
MATERIAL_SCANNER_MODEL=gemini-3.6-flash
SEARCH_RPC=match_products_hybrid
LEGACY_SEARCH_RPC=match_products_semantic
PORT=8000
FLASK_DEBUG=false

# --- APNs push notifications ---
APNS_KEY_ID=your-10-char-key-id
APNS_TEAM_ID=your-10-char-team-id
APNS_BUNDLE_ID=app.finer.fit
# Local: path to the AuthKey_XXXX.p8 you downloaded. On Render this is a
# Secret File mounted at /etc/secrets/apns.p8.
APNS_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
# Shared secret that gates POST /admin/push/broadcast (send yourself a long
# random string; pass it as the X-Admin-Token header when broadcasting).
ADMIN_PUSH_TOKEN=generate-a-long-random-string

# Andrea: apply migrations 012/013 and verify subscription sync before enabling.
# Public rollout stays off. The server has one approved owner preview UUID.
ANDREA_RATINGS_ENABLED=false
# Optional comma-separated verified Supabase UUIDs; empty disables all previews.
# ANDREA_RATINGS_PREVIEW_USER_IDS=
ANDREA_CHAT_MODEL=gpt-4o-mini
ANDREA_RATING_MODEL=gpt-4.1-mini
ANDREA_CHAT_DAILY_LIMIT=5000
ANDREA_RATING_DAILY_LIMIT=500
# Optional native subscription fallback (not required for Supabase grants):
# SUPERWALL_SERVER_API_KEY=server-only-key
# SUPERWALL_APPLICATION_ID=your-application-id
# SUPERWALL_PRO_ENTITLEMENT=your-pro-entitlement-id
