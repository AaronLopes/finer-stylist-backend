SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
MATERIAL_SCANNER_MODEL=gemini-3.6-flash
PORT=8000
FLASK_DEBUG=false

# --- APNs push notifications ---
APNS_KEY_ID=your-10-char-key-id
APNS_TEAM_ID=your-10-char-team-id
APNS_BUNDLE_ID=app.finer.fit
# Local: path to the AuthKey_XXXX.p8 you downloaded. On Render this is a
# Secret File mounted at /etc/secrets/apns.p8.
APNS_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
# Shared secret that gates POST /admin/push/broadcast (send yourself a long
# random string; pass it as the X-Admin-Token header when broadcasting).
ADMIN_PUSH_TOKEN=generate-a-long-random-string
